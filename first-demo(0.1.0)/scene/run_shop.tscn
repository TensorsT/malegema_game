[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/run_shop.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scene/WhatajongBackdrop.tscn" id="2_backdrop"]

[node name="RunShop" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Background" parent="." instance=ExtResource("2_backdrop")]

[node name="ShopPanel" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -360.0
offset_top = -240.0
offset_right = 360.0
offset_bottom = 240.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBoxContainer" type="VBoxContainer" parent="ShopPanel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 12

[node name="TitleLabel" type="Label" parent="ShopPanel/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "商店"
horizontal_alignment = 1

[node name="MoneyLabel" type="Label" parent="ShopPanel/VBoxContainer"]
layout_mode = 2
text = "当前金币：0"
horizontal_alignment = 1

[node name="ItemsContainer" type="VBoxContainer" parent="ShopPanel/VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 10

[node name="StatusLabel" type="Label" parent="ShopPanel/VBoxContainer"]
layout_mode = 2
text = ""
horizontal_alignment = 1

[node name="ActionRow" type="HBoxContainer" parent="ShopPanel/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 12
alignment = 1

[node name="RerollButton" type="Button" parent="ShopPanel/VBoxContainer/ActionRow"]
custom_minimum_size = Vector2(120, 40)
layout_mode = 2
text = "重抽"

[node name="FreezeButton" type="Button" parent="ShopPanel/VBoxContainer/ActionRow"]
custom_minimum_size = Vector2(120, 40)
layout_mode = 2
text = "冻结"

[node name="ContinueButton" type="Button" parent="ShopPanel/VBoxContainer/ActionRow"]
custom_minimum_size = Vector2(140, 40)
layout_mode = 2
text = "继续下一回合"

[connection signal="pressed" from="ShopPanel/VBoxContainer/ActionRow/RerollButton" to="." method="_on_reroll_button_pressed"]
[connection signal="pressed" from="ShopPanel/VBoxContainer/ActionRow/FreezeButton" to="." method="_on_freeze_button_pressed"]
[connection signal="pressed" from="ShopPanel/VBoxContainer/ActionRow/ContinueButton" to="." method="_on_continue_button_pressed"]
