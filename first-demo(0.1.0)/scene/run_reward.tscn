[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/run_reward.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scene/WhatajongBackdrop.tscn" id="2_backdrop"]

[node name="RunReward" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Background" parent="." instance=ExtResource("2_backdrop")]

[node name="RewardPanel" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -320.0
offset_top = -200.0
offset_right = 320.0
offset_bottom = 200.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBoxContainer" type="VBoxContainer" parent="RewardPanel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 12

[node name="TitleLabel" type="Label" parent="RewardPanel/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "奖励"
horizontal_alignment = 1

[node name="SubtitleLabel" type="Label" parent="RewardPanel/VBoxContainer"]
layout_mode = 2
text = "本回合奖励牌"
horizontal_alignment = 1

[node name="RewardsContainer" type="HBoxContainer" parent="RewardPanel/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 10
alignment = 1

[node name="StatusLabel" type="Label" parent="RewardPanel/VBoxContainer"]
layout_mode = 2
text = ""
horizontal_alignment = 1

[node name="ContinueButton" type="Button" parent="RewardPanel/VBoxContainer"]
custom_minimum_size = Vector2(160, 40)
layout_mode = 2
text = "进入商店"

[connection signal="pressed" from="RewardPanel/VBoxContainer/ContinueButton" to="." method="_on_continue_button_pressed"]
