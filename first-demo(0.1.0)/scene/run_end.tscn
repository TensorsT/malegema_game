[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/run_end.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scene/WhatajongBackdrop.tscn" id="2_backdrop"]

[node name="RunEnd" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Background" parent="." instance=ExtResource("2_backdrop")]

[node name="EndPanel" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -380.0
offset_top = -280.0
offset_right = 380.0
offset_bottom = 280.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBoxContainer" type="VBoxContainer" parent="EndPanel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 18

[node name="TitleLabel" type="Label" parent="EndPanel/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 42
text = "结算"
horizontal_alignment = 1

[node name="SummaryLabel" type="Label" parent="EndPanel/VBoxContainer"]
custom_minimum_size = Vector2(0, 350)
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/font_size = 28
text = ""
horizontal_alignment = 1
vertical_alignment = 1

[node name="NewRunButton" type="Button" parent="EndPanel/VBoxContainer"]
custom_minimum_size = Vector2(270, 64)
layout_mode = 2
text = "新的冒险"

[connection signal="pressed" from="EndPanel/VBoxContainer/NewRunButton" to="." method="_on_new_run_button_pressed"]
